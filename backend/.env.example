PORT=5000
# Local development (requires MongoDB running on your machine):
MONGO_URI=mongodb://127.0.0.1:27017/udyamone
# Render: set MONGODB_URI in the Render dashboard to your MongoDB Atlas
# mongodb+srv:// connection string. Do not use localhost or 127.0.0.1 there.
JWT_SECRET=change_this_for_hackathon
AI_SERVICE_URL=http://127.0.0.1:8000

# OpenAI Assistant Configuration (Backend only; never expose to frontend)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
