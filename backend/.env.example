PORT=5000
# Local development (requires MongoDB running on your machine):
MONGO_URI=mongodb://127.0.0.1:27017/udyamone
# Render: set MONGODB_URI in the Render dashboard to your MongoDB Atlas
# mongodb+srv:// connection string. Do not use localhost or 127.0.0.1 there.
JWT_SECRET=change_this_for_hackathon
AI_SERVICE_URL=http://127.0.0.1:8000

# AI Assistant Configuration (Backend only; never expose to frontend)
# Option 1: OpenAI (requires active prepaid balance)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option 2: Google Gemini (Free tier available at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Option 3: Groq (Fast free tier available at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
